generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RateType {
  OFFICIAL
  PARALLEL
}

model ExchangeRate {
  id        Int      @id @default(autoincrement())
  type      RateType @default(OFFICIAL)
  base      String
  target    String
  mid       Decimal  @db.Decimal(18, 4)
  buy       Decimal? @db.Decimal(18, 4)
  sell      Decimal? @db.Decimal(18, 4)
  rateDate  DateTime @db.Date
  source    String
  createdAt DateTime @default(now())

  @@unique([type, base, target, rateDate, source])
  @@index([base, target, rateDate])
  @@map("exchange_rates")
}